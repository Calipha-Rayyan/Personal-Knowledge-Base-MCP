# Copy to .env for local dev. For deployment, set these as environment
# variables in your host's dashboard (Render, etc) instead of committing
# a real .env file.

DATABASE_URL=sqlite:///./knowledge_base.db

SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# Used to build password-reset links.
FRONTEND_URL=http://localhost:5173

# --- Local Qdrant (Docker, no auth) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=document_chunks
QDRANT_IN_MEMORY=false
QDRANT_API_KEY=
QDRANT_USE_HTTPS=false

# --- Qdrant Cloud (free tier) example ---
# QDRANT_HOST=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east.aws.cloud.qdrant.io
# QDRANT_PORT=6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key
# QDRANT_USE_HTTPS=true

EMBEDDING_MODEL=multi-qa-MiniLM-L6-cos-v1

SEARCH_SCORE_THRESHOLD=0.3
SEARCH_TOP_K_DEFAULT=5
SEARCH_TOP_K_MAX=20

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25